-- setuptools.recipe — 84.2.1: python build glue. Installing it restores
-- `import distutils` on python >= 3.12 via the _distutils_hack.pth shim,
-- which is what gobject-introspection's g-ir-scanner (and any distutils
-- user) needs — the scanner crashes without it.

return {
  name           = "setuptools",
  version        = "84.2.1",
  summary        = "Python build system and distutils shim (setuptools)",
  url            = "https://files.pythonhosted.org/packages/70/b3/c19426f783614d625699a4b247faf628ea9ab1db228674491767b417f9e1/setuptools-84.2.1.tar.gz",
  sha256         = "3ff8b3b5492a0aa66960f4419365a86b84e013070d4313e4d4a6894f5d64d6bc",
  deps           = { "python", "glibc" },
  build_system   = "custom",
  build_script   = "build-setuptools.sh",
  test           = "test -d ${DESTDIR}/usr/lib/python3.14/site-packages/setuptools"
    .. " && test -d ${DESTDIR}/usr/lib/python3.14/site-packages/_distutils_hack"
    .. " && test -f ${DESTDIR}/usr/lib/python3.14/site-packages/distutils-precedence.pth"
    .. " && PYTHONPATH=$(echo ${DESTDIR}/usr/lib/python3.14/site-packages) python3 -c \"import setuptools; print(setuptools.__version__)\" | grep -q 84.2.1",
}
