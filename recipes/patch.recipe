-- patch.recipe — GNU patch 2.8.1 (was missing from the base system;
-- gnulib's ./bootstrap and countless build scripts require it).

return {
  name           = "patch",
  version        = "2.8.1",
  summary        = "Patching utility (GNU patch)",
  url            = "https://ftp.gnu.org/gnu/patch/patch-2.8.1.tar.xz",
  sha256         = "3240c7959c5347c8ed347e3c4201c0337bf4240d5cf09d68889e58eeaba30e17",
  deps           = { "glibc", "attr" },
  build_system   = "autotools",
  test           = "test -x ${DESTDIR}/usr/bin/patch"
    .. " && ${DESTDIR}/usr/bin/patch --version | grep -q 2.8.1",
}
