-- gnome-session.recipe — gnome-session 51.0-2: BLFS SysV flow, plus the
-- dinit reality check: gnome-session 51's leader aborts without a systemd
-- user manager (upstream removed the legacy fallback), so the package now
-- ships /usr/bin/gnome-wayland-session — a dbus-session wrapper that
-- starts the gsd plugin daemons and execs gnome-shell (the session core).
-- The wayland-sessions desktop points at the wrapper; it works under any
-- init (iniswap-clean).

return {
  name         = "gnome-session",
  version      = "51.0-2",
  summary      = "GNOME session manager (init-agnostic wiring)",
  url          = "https://download.gnome.org/sources/gnome-session/51/gnome-session-51.0.tar.xz",
  sha256       = "5195c4f60542a953ab6ebd288f3785b8e7746292d8c167e0c99d353438a184d1",
  deps         = { "glibc", "glib", "elogind", "gnome-desktop", "libjson-glib", "mesa-drivers", "upower", "gtk4", "dbus" },
  build_system = "custom",
  build_script = "build-gnome-session.sh",
  test         = "test -x ${DESTDIR}/usr/bin/gnome-session"
    .. " && bash -n ${DESTDIR}/usr/bin/gnome-wayland-session"
    .. " && grep -q '^Exec=/usr/bin/gnome-wayland-session$' ${DESTDIR}/usr/share/wayland-sessions/gnome.desktop"
    .. " && ! find ${DESTDIR} -name '*.service' -o -name '*.target' | grep -q .",
}
