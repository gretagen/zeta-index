-- guile-git 0.10.0 — Guile bindings driving git, required by guix
-- (configure asserts the graph-descendant? export, only in recent releases).

return {
  name           = "guile-git",
  version        = "0.10.0",
  summary        = "Guile bindings for git (required by Guix)",
  url            = "https://gitlab.com/guile-git/guile-git/-/archive/v0.10.0/guile-git-v0.10.0.tar.gz",
  sha256         = "97966a8fb862bf50eb200c92a75039fc655e169a76dcb929e7e6ca3d81b493fc",
  deps           = { "glibc", "guile", "git" },
  build_system   = "custom",
  build_script   = "build-guile-autotools.sh",
  test           = "ls ${DESTDIR}/usr/share/guile/site/3.0/git/*.scm >/dev/null"
    .. " && GUILE_LOAD_PATH=${DESTDIR}/usr/share/guile/site/3.0"
    .. " GUILE_LOAD_COMPILED_PATH=${DESTDIR}/usr/lib/guile/site-ccache"
    .. " guile -c '(use-modules (git))'",
}
