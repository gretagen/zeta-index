-- blueprint-compiler recipe — 0.22.2: GTK Blueprint UI compiler
-- (python), required to build gnome-control-center's .blp panels.
-- Source: GNOME gitlab mirror (the old World/ path is gone).

return {
  name           = "blueprint-compiler",
  version        = "0.22.2",
  summary        = "GTK Blueprint UI definition compiler",
  url            = "https://gitlab.gnome.org/GNOME/blueprint-compiler/-/archive/v0.22.2/blueprint-compiler-v0.22.2.tar.gz",
  sha256         = "ba4dddeb22a1929ed5987e74cb69c592e22bc74f0c04cfdb9028b907cf688af6",
  deps           = { "glibc", "python" },
  build_system   = "meson",
  configure_args = { "--buildtype=release", "--wrap-mode=nodownload" },
  test           = "test -x ${DESTDIR}/usr/bin/blueprint-compiler",
}
