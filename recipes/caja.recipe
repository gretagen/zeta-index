-- caja.recipe — MATE 1.28.0 source build (part of the MATE-from-source campaign
-- replacing nemesis Arch binaries). deps/summary carried from the proven
-- nemesis manifest.

return {
  name           = "caja",
  version        = "1.28.0",
  summary        = "File manager for MATE",
  url            = "https://pub.mate-desktop.org/releases/1.28/caja-1.28.0.tar.xz",
  sha256         = "1e3014ce1455817ec2ef74d09efdfb6835d8a372ed9a16efb5919ef7b821957a",
  deps           = { "glibc", "glib", "gtk3",  "exempi", "gvfs", "libexif", "libSM", "mate-desktop", "libnotify", "gtk-layer-shell"   },
  build_system   = "autotools",
  configure_args = { "--disable-static", "--disable-gtk-doc", "--disable-introspection" },
  test           = "test -n \"$(find ${DESTDIR}/usr -mindepth 1 -type f | head -1)\" && test -x ${DESTDIR}/usr/bin/caja",
}
