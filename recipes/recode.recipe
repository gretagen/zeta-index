-- recode.recipe — 3.7.17: GNU recode charset conversion library and
-- tool. Ported because fortune-mod 1.99.1 includes <recode.h>
-- unconditionally and links -lrecode (sourced from Debian's orig
-- tarball, same as fortune). Custom script wraps autotools: the stock
-- man rule needs help2man --locale (Perl Locale::gettext, absent
-- here), so recode.1 is generated without that flag.

return {
  name         = "recode",
  version      = "3.7.17",
  summary      = "Charset conversion library and tool (GNU recode)",
  url          = "https://deb.debian.org/debian/pool/main/r/recode/recode_3.7.17.orig.tar.gz",
  sha256       = "1b0aebe7283b79ff46bc0a06ee21faf65b4d0b304632cbc855721c25583d8ea3",
  deps         = { "glibc", "libunistring" },
  build_system = "custom",
  build_script = "build-recode.sh",
  test         = "test -f ${DESTDIR}/usr/lib/librecode.so"
    .. " && test -f ${DESTDIR}/usr/include/recode.h"
    .. " && test -f ${DESTDIR}/usr/share/man/man1/recode.1"
    -- LD_LIBRARY_PATH so the staged binary finds its own staged lib
    .. " && LD_LIBRARY_PATH=${DESTDIR}/usr/lib"
    .. " ${DESTDIR}/usr/bin/recode --version 2>&1 | grep -q 3.7.17",
}
