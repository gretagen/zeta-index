-- help2man.recipe — GNU help2man 1.49.3, generates man pages from
-- --help output (required by libidn2's build for idn2.1; another missing
-- base build tool). Perl script, perl already in the index.

return {
  name           = "help2man",
  version        = "1.49.3",
  summary        = "Generate man pages from command --help output (GNU)",
  url            = "https://ftp.gnu.org/gnu/help2man/help2man-1.49.3.tar.xz",
  sha256         = "4d7e4fdef2eca6afe07a2682151cea78781e0a4e8f9622142d9f70c083a2fd4f",
  deps           = { "glibc", "perl" },
  build_system   = "autotools",
  test           = "test -x ${DESTDIR}/usr/bin/help2man"
    .. " && ${DESTDIR}/usr/bin/help2man --version | grep -q 1.49",
}
