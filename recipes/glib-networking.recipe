-- glib-networking.recipe — 2.90.1: GIO TLS module (gnutls backend);
-- hard requirement of libsoup 3 for TLS support. dbus-free, pure GIO
-- module — ships the GIO module cache entry.

return {
  name           = "glib-networking",
  version        = "2.90.1",
  summary        = "Network TLS support for GLib (gnutls backend)",
  url            = "https://download.gnome.org/sources/glib-networking/2.90/glib-networking-2.90.1.tar.xz",
  sha256         = "ea95636590098355a05e3027579dba1a9a950b05e456b2488ea03d82e4b6c18a",
  deps           = { "glibc", "glib", "gnutls", "libproxy" },
  build_system   = "meson",
  configure_args = { "--buildtype=release", "--libdir=/usr/lib", "--wrap-mode=nodownload" },
  test           = "test -e ${DESTDIR}/usr/lib/gio/modules/libgiognutls.so"
    .. " && test -e ${DESTDIR}/usr/lib/gio/modules/libgiolibproxy.so"
    .. " && test -x ${DESTDIR}/usr/libexec/glib-pacrunner",
}
