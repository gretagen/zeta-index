-- gtk3.recipe — 3.24.50-2 rebuilt with introspection enabled (the gir/typelib stack
-- mozo and the GNOME campaign need; same version/flags as installed, plus
-- share/gir-1.0 + lib/girepository-1.0 payloads).
return {
  name           = "gtk3",
  version        = "3.24.50-2",
  summary        = "GTK+ 3 toolkit (X11 + Wayland, gir-enabled rebuild)",
  url            = "https://download.gnome.org/sources/gtk/3.24/gtk-3.24.50.tar.xz",
  sha256         = "399118a5699314622165a11b769ea9b6ed68e037b6d46d57cfcf4851dec07529",
  deps           = { "glibc", "at-spi2-core", "cairo", "fontconfig", "fribidi", "gdk-pixbuf", "harfbuzz", "libX11", "libXcomposite", "libXcursor", "libXdamage", "libXext", "libXfixes", "libXi", "libXinerama", "libXrandr", "libepoxy", "libglvnd", "libz", "pango", "wayland", "xkbcommon", "libcups", "gobject-introspection" },
  build_system   = "meson",
  configure_args = { "--buildtype=release", "--libdir=/usr/lib" },
}
