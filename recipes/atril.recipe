-- atril.recipe — MATE 1.28.1 source build (part of the MATE-from-source campaign
-- replacing nemesis Arch binaries). deps/summary carried from the proven
-- nemesis manifest.

return {
  name           = "atril",
  version        = "1.28.1",
  summary        = "Document viewer for MATE",
  url            = "https://pub.mate-desktop.org/releases/1.28/atril-1.28.1.tar.xz",
  sha256         = "74c4f42979f3ead52def23767448d06ad7f715421e03c9b509404b096de8193e",
  deps           = { "libsecret",  "poppler",  "caja",  "libarchive",  "libSM",  "libICE",  "glibc", "glib", "gtk3",  "djvulibre", "libspectre", "libgxps", "libgepub", "gettext", "poppler-glib", "cairo", "webkit2gtk-4.1", "libsynctex", "mate-desktop"   },
  build_system   = "custom",
  build_script   = "build-atril.sh",
  test           = "test -n \"$(find ${DESTDIR}/usr -mindepth 1 -type f | head -1)\" && test -x ${DESTDIR}/usr/bin/atril",
}
