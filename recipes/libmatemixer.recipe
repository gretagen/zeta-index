-- libmatemixer.recipe — MATE 1.28.0 source build (part of the MATE-from-source campaign
-- replacing nemesis Arch binaries). deps/summary carried from the proven
-- nemesis manifest.

return {
  name           = "libmatemixer",
  version        = "1.28.0",
  summary        = "Mixer library for MATE (Arch binary)",
  url            = "https://pub.mate-desktop.org/releases/1.28/libmatemixer-1.28.0.tar.xz",
  sha256         = "5d73b922397f60688e3c9530eb532bce46c30e262db1b5352fa32c40d870a0c7",
  deps           = {  "alsa-lib", "glib", "pulseaudio", "systemd-libs"  },
  build_system   = "autotools",
  configure_args = { "--disable-static", "--disable-gtk-doc", "--disable-introspection" },
  test           = "test -n \"$(find ${DESTDIR}/usr -mindepth 1 -type f | head -1)\" && test -f ${DESTDIR}/usr/lib/pkgconfig/libmatemixer.pc",
}
