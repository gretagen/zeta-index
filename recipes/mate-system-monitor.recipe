-- mate-system-monitor.recipe — MATE 1.28.1 source build (part of the MATE-from-source campaign
-- replacing nemesis Arch binaries). deps/summary carried from the proven
-- nemesis manifest.

return {
  name           = "mate-system-monitor",
  version        = "1.28.1",
  summary        = "System monitor for MATE",
  url            = "https://pub.mate-desktop.org/releases/1.28/mate-system-monitor-1.28.1.tar.xz",
  sha256         = "42d663d6b90fb5361ebc13f6547983d6f1e2ac75dc2ae4f1cac6ea6329965a25",
  deps           = { "librsvg",  "gdkmm",  "glibc", "glib", "gtk3",  "gtkmm3", "libgtop", "libwnck3", "gettext", "polkit"   },
  build_system   = "custom",
  build_script   = "build-mate-system-monitor.sh",
  test           = "test -n \"$(find ${DESTDIR}/usr -mindepth 1 -type f | head -1)\" && test -x ${DESTDIR}/usr/bin/mate-system-monitor",
}
