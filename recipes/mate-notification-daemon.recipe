-- mate-notification-daemon.recipe — MATE 1.28.3 source build (part of the MATE-from-source campaign
-- replacing nemesis Arch binaries). deps/summary carried from the proven
-- nemesis manifest.

return {
  name           = "mate-notification-daemon",
  version        = "1.28.3",
  summary        = "Notification daemon for MATE",
  url            = "https://pub.mate-desktop.org/releases/1.28/mate-notification-daemon-1.28.3.tar.xz",
  sha256         = "e00cecb1ff9f75b9ccc2644558e44343b80941edb40377dd8100ed3922adf413",
  deps           = { "glibc", "glib", "gtk3",  "libcanberra", "libwnck3", "libnotify", "gettext", "mate-panel"   },
  build_system   = "autotools",
  configure_args = { "--disable-static", "--disable-gtk-doc", "--disable-introspection" },
  test           = "test -n \"$(find ${DESTDIR}/usr -mindepth 1 -type f | head -1)\" && test -x ${DESTDIR}/usr/libexec/mate-notification-daemon",
}
