-- libglvnd.recipe — 1.7.0-2: repack adding the dev payload the package
-- lacked (gl.pc/opengl.pc/egl.pc + GL headers, zero .pc files before) —
-- pkg-config "gl" is a hard configure requirement of mate-session-manager.

return {
  name           = "libglvnd",
  version        = "1.7.0-2",
  summary        = "Vendor-neutral GL dispatch library (with dev payload)",
  url            = "https://github.com/NVIDIA/libglvnd/archive/refs/tags/v1.7.0.tar.gz",
  sha256         = "073e7292788d4d3eeb45ea6c7bdcce9bfdb3b3eef8d7dbd47f2f30dce046ef98",
  deps           = { "glibc", "libX11" },
  build_system   = "meson",
  configure_args = { "--buildtype=release", "--libdir=/usr/lib" },
}
