-- cpufetch.recipe — 1.07 (Dr-Noob/cpufetch): fancy CPU architecture
-- info tool for the terminal. Plain make; no version flag upstream, so
-- the test greps the CPU banner from real output instead.

return {
  name         = "cpufetch",
  version      = "1.07",
  summary      = "Fancy CPU architecture fetching tool",
  url          = "https://github.com/Dr-Noob/cpufetch/archive/refs/tags/v1.07.tar.gz",
  sha256       = "dc3ec8f9c9d41d8434702a778cc150b196d5d178fd768a964f57d22f268a2c17",
  deps         = { "glibc", "gcc" },
  build_system = "custom",
  build_script = "build-cpufetch.sh",
  test         = "test -x ${DESTDIR}/usr/bin/cpufetch"
    .. " && test -f ${DESTDIR}/usr/share/man/man1/cpufetch.1"
    .. " && test -f ${DESTDIR}/usr/share/licenses/cpufetch-git/LICENSE"
    .. " && ${DESTDIR}/usr/bin/cpufetch 2>/dev/null | grep -qiE \"intel|amd|cpu\"",
}
