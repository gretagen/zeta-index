-- chronos.recipe — chronos 1.9.8: HEAD as of 2026-11-21 (17f00c6 —
-- "only use entries it owns for other sys" on top of the reviewed-
-- scripts cleanup and the remove-all/bootable-kernels work). Payload
-- mirrors the previous package: the script alone in usr/bin. Test keeps
-- the established contract (bootable_modules_kernel + cmd_remove_all
-- both still present at HEAD).

return {
  name         = "chronos",
  version      = "1.9.8",
  summary      = "btrfs generation manager for Haliade system (Limine boot entries)",
  url          = "https://github.com/gretagen/chronos/archive/17f00c6760067b61125fa0ef60595794bdd8657f.tar.gz",
  sha256       = "a6d6e3e8b1f8f9b8a95a8e9e7a6e93f320aca8637d32726573114db4025a65c6",
  deps         = { "bash", "btrfs-progs", "util-linux" },
  build_system = "custom",
  build_script = "build-chronos.sh",
  test         = "test -x ${DESTDIR}/usr/bin/chronos"
    .. " && bash -n ${DESTDIR}/usr/bin/chronos"
    .. " && grep -q bootable_modules_kernel ${DESTDIR}/usr/bin/chronos"
    .. " && grep -q cmd_remove_all ${DESTDIR}/usr/bin/chronos",
}
