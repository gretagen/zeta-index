-- pkgconf.recipe — pkg-config implementation, previously absent from the
-- index (host runs an unmanaged ambient copy that lacks pkg.m4, which
-- breaks PKG_CHECK_MODULES expansion during autoreconf).

return {
  name           = "pkgconf",
  version        = "3.0.10",
  summary        = "pkg-config implementation for querying build/library metadata",
  url            = "https://github.com/pkgconf/pkgconf/releases/download/pkgconf-3.0.10/pkgconf-3.0.10.tar.gz",
  sha256         = "d01a1b82f0884112d08c6dfad46f43f415d070a6a5a6aaa77ebf2674e973a9b5",
  deps           = { "glibc" },
  build_system   = "meson",
  configure_args = { "--buildtype=release", "--libdir=lib" },
  -- upstream 3.x only installs `pkgconf`; distros provide the pkg-config name
  post_install   = "ln -sf pkgconf ${DESTDIR}/usr/bin/pkg-config",
  test           = "test -x ${DESTDIR}/usr/bin/pkgconf && test -x ${DESTDIR}/usr/bin/pkg-config && test -f ${DESTDIR}/usr/share/aclocal/pkg.m4 && LD_LIBRARY_PATH=${DESTDIR}/usr/lib ${DESTDIR}/usr/bin/pkg-config --version",
}
