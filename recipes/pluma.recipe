-- pluma.recipe — MATE 1.28.0 source build (part of the MATE-from-source campaign
-- replacing nemesis Arch binaries). deps/summary carried from the proven
-- nemesis manifest.

return {
  name           = "pluma",
  version        = "1.28.0",
  summary        = "Text editor for MATE",
  url            = "https://pub.mate-desktop.org/releases/1.28/pluma-1.28.0.tar.xz",
  sha256         = "aa8adf9589345093a50e30b27ede4a78a2421d1727c27f465fc87c435965a1d4",
  deps           = { "glibc", "glib", "gtk3",  "iso-codes", "mate-desktop", "zenity", "gtksourceview4", "libpeas", "gettext", "enchant", "libSM"   },
  build_system   = "custom",
  build_script   = "build-pluma.sh",
  test           = "test -n \"$(find ${DESTDIR}/usr -mindepth 1 -type f | head -1)\" && test -x ${DESTDIR}/usr/bin/pluma",
}
