-- xdg-desktop-portal-gtk.recipe — 1.15.3: GTK file-chooser/settings
-- backend for xdg-desktop-portal. Coexists with the wlr and gnome
-- backends (the portal selects per interface). Any systemd files are
-- stripped by the toolchain's clean_stage (usr/lib/systemd is blocked).

return {
  name           = "xdg-desktop-portal-gtk",
  version        = "1.15.3",
  summary        = "GTK backend for xdg-desktop-portal (file chooser, settings)",
  url            = "https://github.com/flatpak/xdg-desktop-portal-gtk/releases/download/1.15.3/xdg-desktop-portal-gtk-1.15.3.tar.xz",
  sha256         = "47a3743d2419a8601e691db37e85bb5fac5ae4b26842177065cd5f22ada23b37",
  deps           = { "glibc", "glib", "gtk3", "xdg-desktop-portal", "gnome-desktop" },
  build_system   = "meson",
  configure_args = { "--buildtype=release", "--libdir=/usr/lib", "--wrap-mode=nodownload" },
  test           = "test -x ${DESTDIR}/usr/libexec/xdg-desktop-portal-gtk"
    .. " && test -f ${DESTDIR}/usr/share/xdg-desktop-portal/portals/gtk.portal"
    .. " && test -f ${DESTDIR}/usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.gtk.service"
    .. " && ! ls ${DESTDIR}/usr/lib/systemd 2>/dev/null | grep -q .",
}
