-- libconfig.recipe — 1.8.3: configuration file library (C API with a
-- C++ core), required by picom (dependency('libconfig') >= 1.7).
-- Ported because it was in neither the index nor on the host, and
-- picom's meson fallback would otherwise try to download its wrap.
-- The tag archive ships only configure.ac, so autoreconf first.
-- libstdc++ is owned by the gcc package in this index, so gcc joins
-- the deps — the { glibc, gcc } pattern every C++ package here uses
-- (sassc, atkmm, ...).

return {
  name         = "libconfig",
  version      = "1.8.3",
  summary      = "Configuration file processing library",
  url          = "https://github.com/hyperrealm/libconfig/archive/refs/tags/v1.8.3.tar.gz",
  sha256       = "683f723d647befcdb36e1a4a61a83ae8c89dc7959ca872a7407b6c8152104162",
  deps         = { "glibc", "gcc" },
  build_system = "custom",
  build_script = "build-libconfig.sh",
  test         = "test -f ${DESTDIR}/usr/lib/libconfig.so"
    .. " && test -f ${DESTDIR}/usr/lib/pkgconfig/libconfig.pc"
    .. " && test -f ${DESTDIR}/usr/include/libconfig.h"
    -- Functional smoke test: compile and run a program against the
    -- staged library (gcc, not cc — no cc symlink on this host; rpath
    -- so the run resolves the staged libconfig.so, which links the
    -- ambient libstdc++ for its C++ core).
    .. " && printf '#include <libconfig.h>\\nint main(){config_t c; config_init(&c); config_destroy(&c); return 0;}\\n' > /tmp/libconfig-smoke.c"
    .. " && gcc /tmp/libconfig-smoke.c -I${DESTDIR}/usr/include"
    .. " -Wl,-rpath,${DESTDIR}/usr/lib ${DESTDIR}/usr/lib/libconfig.so -o /tmp/libconfig-smoke"
    .. " && /tmp/libconfig-smoke",
}
