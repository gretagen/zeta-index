-- egl.recipe — repack1.5: the package shipped EGL headers and libEGL/
-- libGLdispatch but no KHR/khrplatform.h (no package did), so every
-- consumer of <EGL/eglplatform.h> failed to compile - including noctalia.
-- Rebuilt coherently from libglvnd: EGL + KHR headers, libEGL and
-- libGLdispatch (original payload), plus libGLESv2 and glesv2.pc, which
-- the glesv2->epoxy pkg-config fallback chain also needed. The two
-- mesa-specific headers of the old payload (eglext_angle.h,
-- eglmesaext.h) are not part of libglvnd and are dropped.

return {
  name           = "egl",
  version        = "1.5-3",
  summary        = "EGL interface library (stub pkgconfig for libglvnd EGL)",
  url            = "https://github.com/NVIDIA/libglvnd/archive/refs/tags/v1.7.0.tar.gz",
  sha256         = "073e7292788d4d3eeb45ea6c7bdcce9bfdb3b3eef8d7dbd47f2f30dce046ef98",
  deps           = { "glibc" },
  build_system   = "custom",
  build_script   = "build-egl.sh",
  files          = {
    "usr/include/EGL/egl.h",
    "usr/include/EGL/eglext.h",
    "usr/include/EGL/eglplatform.h",
    "usr/include/GLES2/gl2.h",
    "usr/include/GLES2/gl2ext.h",
    "usr/include/GLES2/gl2platform.h",
    "usr/include/KHR/khrplatform.h",
    "usr/lib/libEGL.so",
    "usr/lib/libEGL.so.1",
    "usr/lib/libEGL.so.1.1.0",
    "usr/lib/libGLdispatch.so",
    "usr/lib/libGLdispatch.so.0",
    "usr/lib/libGLdispatch.so.0.0.0",
    "usr/lib/libGLESv2.so",
    "usr/lib/libGLESv2.so.2",
    "usr/lib/libGLESv2.so.2.1.0",
    "usr/lib/pkgconfig/egl.pc",
    "usr/lib/pkgconfig/glesv2.pc",
  },
  test           = "test -f ${DESTDIR}/usr/include/KHR/khrplatform.h && test -f ${DESTDIR}/usr/include/EGL/eglplatform.h && test -f ${DESTDIR}/usr/include/GLES2/gl2.h && test -f ${DESTDIR}/usr/lib/pkgconfig/egl.pc && test -f ${DESTDIR}/usr/lib/pkgconfig/glesv2.pc && test -e ${DESTDIR}/usr/lib/libEGL.so.1",
}
