-- pcaudiolib.recipe — portable C audio playback library (ALSA), the audio
-- backend espeak-ng's cmake build uses (USE_LIBPCAUDIO). Moved upstream
-- from libpcaudio/pcaudiolib to the espeak-ng org.

return {
  name         = "pcaudiolib",
  version      = "1.3",
  summary      = "Portable C audio playback library (ALSA)",
  url          = "https://github.com/espeak-ng/pcaudiolib/archive/refs/tags/1.3.tar.gz",
  sha256       = "86edb75048eec7fcd8d74f9568f051d50b4781982215095b96ba9c2c9c7c159b",
  deps         = { "glibc", "alsa-lib", "pulseaudio" },
  build_system = "custom",
  build_script = "build-pcaudiolib.sh",
  test         = "ls ${DESTDIR}/usr/lib/libpcaudio.so* >/dev/null && test -f ${DESTDIR}/usr/include/pcaudiolib/audio.h",
}
