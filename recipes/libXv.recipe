-- libXv.recipe — 1.0.13-2: rebuild with a proper SONAME symlink chain.
-- The previous package shipped libXv.so.1 as a REGULAR FILE (a copy of
-- .1.0.0), so the dynamic linker warned "libXv.so.1 is not a symbolic
-- link" on every ldconfig run.

return {
  name           = "libXv",
  version        = "1.0.13-2",
  summary        = "X11 Video extension library (fixed .so symlinks)",
  url            = "https://www.x.org/releases/individual/lib/libXv-1.0.13.tar.xz",
  sha256         = "7d34910958e1c1f8d193d828fea1b7da192297280a35437af0692f003ba03755",
  deps           = { "glibc", "libX11", "libXext" },
  build_system   = "autotools",
  configure_args = { "--disable-static" },
  test           = "test -L ${DESTDIR}/usr/lib/libXv.so.1"
    .. " && test -e ${DESTDIR}/usr/lib/libXv.so.1.0.0"
    .. " && readelf -d ${DESTDIR}/usr/lib/libXv.so.1.0.0 | grep -q 'Library soname: \\[libXv.so.1\\]'",
}
