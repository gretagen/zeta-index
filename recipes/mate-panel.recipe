-- mate-panel.recipe — MATE 1.28.4 source build (part of the MATE-from-source campaign
-- replacing nemesis Arch binaries). deps/summary carried from the proven
-- nemesis manifest.

return {
  name           = "mate-panel",
  version        = "1.28.4",
  summary        = "Panel for MATE",
  url            = "https://pub.mate-desktop.org/releases/1.28/mate-panel-1.28.4.tar.xz",
  sha256         = "02f09eb0314c2ac197b6f089950a571cdba39bfd03d6c3a0b8fd77252a968874",
  deps           = { "libsoup2", "startup-notification", "libdconf", "glibc", "glib", "gtk3",  "dbus-glib", "libwnck3", "libcanberra", "libmateweather", "libSM", "mate-menus", "mate-desktop", "gettext", "gtk-layer-shell"   },
  build_system   = "custom",
  build_script   = "build-mate-panel.sh",
  test           = "test -n \"$(find ${DESTDIR}/usr -mindepth 1 -type f | head -1)\" && test -x ${DESTDIR}/usr/bin/mate-panel",
}
