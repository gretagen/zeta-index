-- zeta.recipe — Zeta package manager 2.1: HEAD as of 2026-11-21
-- (d4a6192 — faster updates; e1d0bbe — base generation protected
-- from deletion). Carries the earlier rooted-system-ops + atomic-
-- transcendence + precise-listing work (ldconfig -r for non-host
-- roots — plain ldconfig had only ever rewritten the host cache,
-- leaving deployed trees with the stale cache shipped inside the
-- glibc payload; plus the missing top-level etc/ld.so.conf whose
-- include makes ld.so.conf.d snippets visible; desktop/icon caches
-- rooted, gdk-pixbuf chrooted — host branch unchanged). Built from
-- the exact commit on main. Payload mirrors the previous package:
-- launcher + entry point + library tree; the launcher resolves
-- zeta.lua relative to itself, so staged runs work for the -Help
-- smoke test.

return {
  name           = "zeta",
  version        = "2.1",
  summary        = "Zeta package manager for Haliade system",
  url            = "https://github.com/gretagen/ZETA/archive/d4a6192e71644d7cdeb9bc0ecbb408a57079337c.tar.gz",
  sha256         = "8027982f262b4bd7d11ecb337d7d2ca778c351752249e46ab69961ad5a0db33f",
  deps           = { "lua", "patchelf", "desktop-file-utils" },
  build_system   = "custom",
  build_script   = "build-zeta.sh",
  test           = "test -x ${DESTDIR}/usr/bin/zeta"
    .. " && test -f ${DESTDIR}/usr/lib/zeta/zeta.lua"
    .. " && ! test -f ${DESTDIR}/usr/lib/zeta/lib/adopt.lua"
    .. " && for f in ${DESTDIR}/usr/lib/zeta/zeta.lua ${DESTDIR}/usr/lib/zeta/lib/*.lua; do lua -e \"assert(loadfile('$f'))\" || exit 1; done"
    -- (the launcher is now a generic flag dispatcher, so -Delete only
    -- needs to exist in cli.lua — asserted below)
    .. " && ! grep -q -- '-Remove' ${DESTDIR}/usr/bin/zeta"
    .. " && grep -q -- '-Delete' ${DESTDIR}/usr/lib/zeta/lib/cli.lua"
    .. " && ! grep -q -- '-Remove' ${DESTDIR}/usr/lib/zeta/lib/cli.lua"
    -- regression guard: non-host roots must get a ROOTED ldconfig.
    .. " && grep -q 'ldconfig -r' ${DESTDIR}/usr/lib/zeta/lib/commit.lua"
    .. " && ${DESTDIR}/usr/bin/zeta -Help | grep -q 'Usage: zeta'",
}
