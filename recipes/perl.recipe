-- perl.recipe — perl 5.42.3-3: rebuild with -Dcc=gcc. The -2 build left
-- Config with cc='cc' and this system ships no /usr/bin/cc, so any XS
-- module build (XML::Parser -> Devel::CheckLib compiler probe) failed with
-- "Couldn't find your C compiler". Layout identical to -2 (arch-style
-- vendor dirs under /usr/lib/perl5); keeps the -2 payload tripwires and
-- adds a Config regression guard.

return {
  name           = "perl",
  version        = "5.42.3-3",
  summary        = "Perl interpreter",
  url            = "https://www.cpan.org/src/5.0/perl-5.42.3.tar.xz",
  sha256         = "c9387e1473a1866935cb047ece7c2e0a80767a3acdecb79d4a375f8a95970ddc",
  deps           = { "glibc", "libxcrypt", "gdbm" },
  build_system   = "custom",
  build_script   = "build-perl.sh",
  test           = "test -x ${DESTDIR}/usr/bin/perl"
    .. " && test -f ${DESTDIR}/usr/lib/perl5/5.42.3/AnyDBM_File.pm"
    .. " && test -f ${DESTDIR}/usr/lib/perl5/5.42.3/x86_64-linux-thread-multi/CORE/libperl.so"
    .. " && grep -qE \"^cc=.gcc.\" ${DESTDIR}/usr/lib/perl5/5.42.3/x86_64-linux-thread-multi/Config_heavy.pl"
    .. " && ${DESTDIR}/usr/bin/perl -e \"print 42\" | grep -q 42"
    .. " && ! find ${DESTDIR} -maxdepth 1 -type f | grep -q .",
}
