-- eom.recipe — MATE 1.28.0 source build (part of the MATE-from-source campaign
-- replacing nemesis Arch binaries). deps/summary carried from the proven
-- nemesis manifest.

return {
  name           = "eom",
  version        = "1.28.0",
  summary        = "Image viewer for MATE",
  url            = "https://pub.mate-desktop.org/releases/1.28/eom-1.28.0.tar.xz",
  sha256         = "9a01cab2995a1a8c7258c865eae5f182ed4730c44672afdc3a07e423edd53abc",
  deps           = { "librsvg",  "glibc", "glib", "gtk3",  "dbus-glib", "gettext", "exempi", "lcms2", "libexif", "libjpeg-turbo", "mate-desktop", "libpeas"   },
  build_system   = "custom",
  build_script   = "build-eom.sh",
  test           = "test -n \"$(find ${DESTDIR}/usr -mindepth 1 -type f | head -1)\" && test -x ${DESTDIR}/usr/bin/eom",
}
