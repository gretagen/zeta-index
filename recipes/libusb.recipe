-- libusb.recipe — 1.0.30-2: repack fixing the libdir. 1.0.30 installed
-- into /usr/lib64 (pc invisible to pkg-config); libgusb/colord/mutter
-- need libusb-1.0.pc from the normal path.

return {
  name           = "libusb",
  version        = "1.0.30-2",
  summary        = "user-space USB library (libusb-1.0)",
  url            = "https://github.com/libusb/libusb/releases/download/v1.0.30/libusb-1.0.30.tar.bz2",
  sha256         = "fea36f34f9156400209595e300840767ab1a385ede1dc7ee893015aea9c6dbaf",
  deps           = { "glibc", "systemd-libs" },
  build_system   = "autotools",
  configure_args = { "--disable-static", "--libdir=/usr/lib" },
  test           = "test -e ${DESTDIR}/usr/lib/libusb-1.0.so.0"
    .. " && PKG_CONFIG_PATH=${DESTDIR}/usr/lib/pkgconfig pkg-config --exists libusb-1.0",
}
