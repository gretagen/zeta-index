-- protobuf.recipe — 6.31.1: Google's protobuf runtime + protoc
-- compiler (github.com/protocolbuffers/protobuf, latest stable tag).
-- Ported because chiaki-ng's lib/protobuf compiles its registration
-- .proto files with protoc, which existed neither on the host nor in
-- the index. No submodules (utf8_range is vendored in-tree). absl is
-- handled the upstream way: find_package(absl) first, FetchContent
-- fallback — the indexed abseil-cpp ships libs only (no headers/pc/
-- cmake), so protobuf vendors its own absl (soversion 2501, no file
-- overlap with abseil-cpp's 2601 libs) and stays self-contained;
-- shared libprotobuf so chiaki's edge resolves through this package.
-- CMAKE_INSTALL_LIBDIR=lib keeps GNUInstallDirs off lib64 (this
-- distro installs to /usr/lib). Tests off.

return {
  name         = "protobuf",
  version      = "6.31.1",
  summary      = "Protocol Buffers runtime and compiler (protoc)",
  url          = "https://github.com/protocolbuffers/protobuf/archive/refs/tags/v6.31.1.tar.gz",
  sha256       = "597071a340acc5346494c119ba3a541825c3f81071fc783521b24e29a485d60f",
  deps         = { "glibc", "gcc" },
  build_system = "cmake",
  configure_args = { "-Dprotobuf_BUILD_TESTS=OFF",
                     "-Dprotobuf_BUILD_SHARED_LIBS=ON",
                     "-DCMAKE_INSTALL_LIBDIR=lib" },
  test         = "test -x ${DESTDIR}/usr/bin/protoc"
    .. " && test -f ${DESTDIR}/usr/lib/pkgconfig/protobuf.pc"
    .. " && ls ${DESTDIR}/usr/lib/libprotobuf.so* | grep -q libprotobuf"
    -- staged run: protoc needs the staged libprotobuf/libprotoc
    .. " && LD_LIBRARY_PATH=${DESTDIR}/usr/lib ${DESTDIR}/usr/bin/protoc --version",
}
