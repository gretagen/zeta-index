-- mate-media.recipe — MATE 1.28.1 source build (part of the MATE-from-source campaign
-- replacing nemesis Arch binaries). deps/summary carried from the proven
-- nemesis manifest.

return {
  name           = "mate-media",
  version        = "1.28.1",
  summary        = "Media manager for MATE",
  url            = "https://pub.mate-desktop.org/releases/1.28/mate-media-1.28.1.tar.xz",
  sha256         = "bcdc102e22f63f55e63166d5c708e91c113570e6a30a874345a88609e83a9912",
  deps           = { "glibc", "glib", "gtk3",  "libcanberra", "libmatemixer", "mate-desktop", "mate-panel", "gettext"   },
  build_system   = "autotools",
  configure_args = { "--disable-static", "--disable-gtk-doc", "--disable-introspection" },
  test           = "test -n \"$(find ${DESTDIR}/usr -mindepth 1 -type f | head -1)\"",
}
