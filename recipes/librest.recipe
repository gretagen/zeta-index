-- librest recipe — 0.10.2: REST API client library, required by
-- gnome-online-accounts (GOA's meson falls back to a subproject wrap for
-- rest-1.0; the system library satisfies it).

return {
  name           = "librest",
  version        = "0.10.2",
  summary        = "REST API client library (librest-1.0)",
  url            = "https://download.gnome.org/sources/librest/0.10/librest-0.10.2.tar.xz",
  sha256         = "7b6cb912bb3a22cfa7dcf005925dcb62883024db0c09099486e7d6851185c9b8",
  deps           = { "glibc", "glib", "libsoup3", "gtk4", "libjson-glib" },
  build_system   = "meson",
  configure_args = { "--buildtype=release", "--libdir=/usr/lib", "--wrap-mode=nodownload",
                     "-Dexamples=false", "-Dgtk_doc=false" },
  test           = "ls ${DESTDIR}/usr/lib/librest-1.0.so* | grep -q ."
    .. " && PKG_CONFIG_PATH=${DESTDIR}/usr/lib/pkgconfig pkg-config --exists rest-1.0",
}
