-- wev.recipe — 1.1.0: Wayland event viewer (the xev/evtest analogue
-- for Wayland, ~sircmpwn/wev — Drew DeVault). Plain make: pkg-config
-- wayland-client + xkbcommon, xdg-shell/tablet-v2 protocol sources
-- generated by wayland-scanner from the system wayland-protocols, man
-- page from wev.1.scd via scdoc. Runtime closure is just wayland +
-- xkbcommon (wayland-protocols and scdoc are build-time only).

return {
  name         = "wev",
  version      = "1.1.0",
  summary      = "Wayland event viewer (xev for Wayland)",
  url          = "https://git.sr.ht/~sircmpwn/wev/archive/1.1.0.tar.gz",
  sha256       = "89b8d9bc756631795ee91c99a0d5b0877c9f5c3acfe81f77a2b69ecfc15daf16",
  deps         = { "glibc", "wayland", "xkbcommon" },
  build_system = "custom",
  build_script = "build-wev.sh",
  test         = "test -x ${DESTDIR}/usr/bin/wev"
    .. " && test -f ${DESTDIR}/usr/share/man/man1/wev.1"
    -- -h prints usage (grep decides the pipe's status, whatever the
    -- binary's own exit code is); no display needed for help.
    .. " && ${DESTDIR}/usr/bin/wev -h 2>&1 | grep -qi usage",
}
