-- mate-control-center.recipe — MATE 1.28.0 source build (part of the MATE-from-source campaign
-- replacing nemesis Arch binaries). deps/summary carried from the proven
-- nemesis manifest.

return {
  name           = "mate-control-center",
  version        = "1.28.0",
  summary        = "Control center for MATE",
  url            = "https://pub.mate-desktop.org/releases/1.28/mate-control-center-1.28.0.tar.xz",
  sha256         = "ebf2c704fd5248dc2f9836ff29028869ef29d5054907cc615734b6383a7914bc",
  deps           = { "libdbusmenu-glib",  "libxss",  "glibc", "glib", "gtk3",  "mate-menus", "mate-settings-daemon", "marco", "mate-desktop", "gettext", "accountsservice", "mate-panel", "libcanberra", "udisks2", "libayatana-appindicator"   },
  build_system   = "custom",
  build_script   = "build-mate-control-center.sh",
  test           = "test -n \"$(find ${DESTDIR}/usr -mindepth 1 -type f | head -1)\" && test -x ${DESTDIR}/usr/bin/mate-control-center",
}
