-- libmpc.recipe — GNU MPC 1.3.1: complex-number math lib mate-calc uses
-- for currency math (mpc.h missing from the host).

return {
  name           = "libmpc",
  version        = "1.3.1",
  summary        = "GNU Multiple Precision Complex Library",
  url            = "https://ftp.gnu.org/gnu/mpc/mpc-1.3.1.tar.gz",
  sha256         = "ab642492f5cf882b74aa0cb730cd410a81edcdbec895183ce930e706c1c759b8",
  deps           = { "mpfr",  "glibc", "gmp" },
  build_system   = "autotools",
  configure_args = { "--disable-static" },
  test           = "test -f ${DESTDIR}/usr/include/mpc.h"
    .. " && test -e ${DESTDIR}/usr/lib/libmpc.so",
}
