-- engrampa.recipe — MATE 1.28.2 source build (part of the MATE-from-source campaign
-- replacing nemesis Arch binaries). deps/summary carried from the proven
-- nemesis manifest.

return {
  name           = "engrampa",
  version        = "1.28.2",
  summary        = "File archiver for MATE",
  url            = "https://pub.mate-desktop.org/releases/1.28/engrampa-1.28.2.tar.xz",
  sha256         = "1e9977c23745bf8843a37f315171d9af97814a0971aeac3d774f017650ac09ef",
  deps           = { "libjson-glib",  "caja",  "libSM",  "libICE",  "glibc",  "gtk3", "gzip", "gettext", "libarchive", "tar", "unzip", "zip"  },
  build_system   = "custom",
  build_script   = "build-engrampa.sh",
  test           = "test -n \"$(find ${DESTDIR}/usr -mindepth 1 -type f | head -1)\" && test -x ${DESTDIR}/usr/bin/engrampa",
}
