-- mate-screensaver.recipe — MATE 1.28.0 source build (part of the MATE-from-source campaign
-- replacing nemesis Arch binaries). deps/summary carried from the proven
-- nemesis manifest.

return {
  name           = "mate-screensaver",
  version        = "1.28.0",
  summary        = "Screen saver for MATE",
  url            = "https://pub.mate-desktop.org/releases/1.28/mate-screensaver-1.28.0.tar.xz",
  sha256         = "6a0f24a8f84a2f95e10114ab53e63fd4aca688a55fdc503ed650e0a410e3ea70",
  deps           = { "libxss", "libXxf86vm",  "glibc", "glib", "gtk3",  "mate-panel", "libmatekbd", "gettext", "libnotify", "mate-desktop", "mate-menus", "mate-session-manager"   },
  build_system   = "autotools",
  configure_args = { "--disable-static", "--disable-gtk-doc", "--disable-introspection" },
  test           = "test -n \"$(find ${DESTDIR}/usr -mindepth 1 -type f | head -1)\" && test -x ${DESTDIR}/usr/bin/mate-screensaver",
}
