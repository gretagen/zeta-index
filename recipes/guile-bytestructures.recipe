-- guile-bytestructures 1.0.10 — bytevector structure bindings, required
-- by guile-git (which guix's configure insists on).

return {
  name           = "guile-bytestructures",
  version        = "1.0.10",
  summary        = "Structured bytevector access for Guile (needed by guile-git)",
  url            = "https://github.com/TaylanUB/scheme-bytestructures/archive/refs/tags/v1.0.10.tar.gz",
  sha256         = "4902118f1114a790464b6ae73d83476541ac5fddc99a22f6d7cecb5f1b469728",
  deps           = { "glibc", "guile" },
  build_system   = "custom",
  build_script   = "build-guile-autotools.sh",
  test           = "ls ${DESTDIR}/usr/share/guile/site/3.0/bytestructures/*.scm >/dev/null"
    .. " && GUILE_LOAD_PATH=${DESTDIR}/usr/share/guile/site/3.0"
    .. " GUILE_LOAD_COMPILED_PATH=${DESTDIR}/usr/lib/guile/site-ccache"
    .. " guile -c '(use-modules (bytestructures guile))'",
}
