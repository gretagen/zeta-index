-- mate-terminal.recipe — MATE 1.28.1 source build (part of the MATE-from-source campaign
-- replacing nemesis Arch binaries). deps/summary carried from the proven
-- nemesis manifest.

return {
  name           = "mate-terminal",
  version        = "1.28.1",
  summary        = "Terminal emulator for MATE",
  url            = "https://pub.mate-desktop.org/releases/1.28/mate-terminal-1.28.1.tar.xz",
  sha256         = "f135eb1a9e2ae22798ecb2dc1914fdb4cfd774e6bb65c0152be37cc6c9469e92",
  deps           = { "glibc", "glib", "gtk3",  "libSM", "gettext", "mate-desktop", "vte", "perl"   },
  build_system   = "custom",
  build_script   = "build-mate-terminal.sh",
  test           = "test -n \"$(find ${DESTDIR}/usr -mindepth 1 -type f | head -1)\" && test -x ${DESTDIR}/usr/bin/mate-terminal",
}
