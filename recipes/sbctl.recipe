-- sbctl.recipe — 0.18: userspace Secure Boot key manager (Foxboron,
-- https://github.com/Foxboron/sbctl). Creates/enrolls custom keys and
-- signs EFI binaries; pure Go (go-uefi), so the runtime closure is just
-- glibc. Man pages are omitted: docs/*.txt need a2x/asciidoc, absent
-- on this host. Completions are generated by the binary itself.
-- Init-agnostic: no units ship (the kernel-install .install files are
-- bootloader tooling, not init services).

return {
  name         = "sbctl",
  version      = "0.18",
  summary      = "Secure Boot key manager and EFI signing tool",
  url          = "https://github.com/Foxboron/sbctl/releases/download/0.18/sbctl-0.18.tar.gz",
  sha256       = "d274451b145b0aaecfdf2d01ad45473b61ab40f3f58e4735cee50aa7573c584d",
  deps         = { "glibc", "pcsc-lite" },
  build_system = "custom",
  build_script = "build-sbctl.sh",
  test         = "test -x ${DESTDIR}/usr/bin/sbctl"
    .. " && ${DESTDIR}/usr/bin/sbctl --help | grep -q enroll-keys"
    .. " && ${DESTDIR}/usr/bin/sbctl version | grep -q '0.18'"
    .. " && test -f ${DESTDIR}/usr/share/bash-completion/completions/sbctl"
    .. " && test -f ${DESTDIR}/usr/share/licenses/sbctl/LICENSE",
}
