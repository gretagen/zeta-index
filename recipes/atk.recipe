-- atk.recipe — atk 2.38.0 (new port): the accessibility peer gtk3 needs,
-- with introspection on — Atk-1.0.gir is a hard requirement of gtk3's
-- own gir generation, and the index had no atk at all.

return {
  name           = "atk",
  version        = "2.38.0",
  summary        = "Accessibility toolkit GTK3 peer (atk)",
  url            = "https://download.gnome.org/sources/atk/2.38/atk-2.38.0.tar.xz",
  sha256         = "ac4de2a4ef4bd5665052952fe169657e65e895c5057dffb3c2a810f6191a0c36",
  deps           = { "glibc", "glib", "gobject-introspection" },
  build_system   = "meson",
  configure_args = { "--buildtype=release", "--libdir=/usr/lib", "-Dintrospection=true" },
}
