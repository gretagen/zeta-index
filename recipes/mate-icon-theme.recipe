-- mate-icon-theme.recipe — MATE 1.28.0 source build (part of the MATE-from-source campaign
-- replacing nemesis Arch binaries). deps/summary carried from the proven
-- nemesis manifest.

return {
  name           = "mate-icon-theme",
  version        = "1.28.0",
  summary        = "Icon theme for MATE",
  url            = "https://pub.mate-desktop.org/releases/1.28/mate-icon-theme-1.28.0.tar.xz",
  sha256         = "94d6079060ca5df74542921de4eea38b7d02d07561c919356d95de876f9a6d3a",
  deps           = { "glibc" },
  build_system   = "autotools",
  configure_args = { "--disable-static", "--disable-gtk-doc" },
  test           = "test -n \"$(find ${DESTDIR}/usr -mindepth 1 -type f | head -1)\"",
}
